# Copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=production
PORT=3000

# Amazon RDS (MySQL) — endpoint from the RDS console
DB_HOST=yallain-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASS=change-me
DB_NAME=yallain

# AWS — no access keys here: on EC2 the SDK uses the instance's IAM role
AWS_REGION=us-east-1
# Private bucket for ID photos. Leave empty for local mode (files saved in app/uploads, Lambda simulated).
S3_IDS_BUCKET=yallain-ids-yourteam
# Public assets bucket URL (hero photo, panels, artist images). Leave empty to serve from the repo's assets/ folder.
ASSETS_BASE_URL=https://yallain-assets-yourteam.s3.us-east-1.amazonaws.com

# WR3 one-time code: "sms" sends through Amazon SNS, "demo" prints it in the logs and shows it on the page
OTP_MODE=demo

# Long random strings, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ID_HASH_SECRET=

# Only set true once the site is served over HTTPS
COOKIE_SECURE=false
